<Window x:Class="DeploymentManager.Views.MappingEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application Mapping Configuration" Height="720" Width="740"
        MinHeight="620" MinWidth="640" WindowStartupLocation="CenterOwner"
        Background="{StaticResource DarkBgCanvasBrush}"
        Icon="{StaticResource DeploymentIcon}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource DarkSurfaceBrush}"
                BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="18,14" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="APPLICATION MAPPING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGoldBrush}" />
                <TextBlock Text="Configure Deployment Parameters" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <!-- Form Fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="2,0,6,0">
                <TextBlock Text="APPLICATION NAME" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                <TextBlock Text="SOURCE FOLDER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <DockPanel Margin="0,0,0,16">
                    <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseSourceCommand}" Margin="10,0,0,0" />
                    <TextBox Text="{Binding SourceFolder, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                </DockPanel>

                <TextBlock Text="DESTINATION FOLDER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <DockPanel Margin="0,0,0,18">
                    <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseDestinationCommand}" Margin="10,0,0,0" />
                    <TextBox Text="{Binding DestinationFolder, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                </DockPanel>

                <!-- Toggle Options Card -->
                <Border Background="{StaticResource DarkBgSubBrush}" BorderBrush="{StaticResource DarkBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox Content="Mapping enabled" IsChecked="{Binding Enabled}" Margin="0,0,0,10" />
                        <CheckBox Content="Back up overwritten files" IsChecked="{Binding BackupEnabled}" Margin="0,0,0,10" />
                        <CheckBox Content="JavaScript scaffolding enabled" IsChecked="{Binding JavaScriptScaffoldingEnabled}" />
                    </StackPanel>
                </Border>

                <!-- IIS App Pool Card -->
                <Border Background="{StaticResource DarkBgSubBrush}" BorderBrush="{StaticResource DarkBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14,12">
                    <StackPanel>
                        <CheckBox Content="Stop and restart an IIS application pool during deployment"
                                  IsChecked="{Binding ManageIisAppPool}" FontWeight="SemiBold" />
                        <TextBlock Text="Use only when this mapping targets a Windows IIS-hosted application."
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="24,4,0,10" />
                        <Grid IsEnabled="{Binding ManageIisAppPool}" Margin="24,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="IIS SERVER (blank = local host)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding IisServer, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="APPLICATION POOL NAME" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding IisAppPoolName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource StatusRedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" FontWeight="SemiBold" />
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,20,0,0">
            <Button DockPanel.Dock="Right" Content="Save Mapping" Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" Padding="22,9" />
            <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,10,0" Padding="16,9" />
        </DockPanel>
    </Grid>
</Window>